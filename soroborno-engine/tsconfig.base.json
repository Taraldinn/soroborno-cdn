{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shoroborno/core": ["./packages/core/dist/index.d.ts"],
      "@shoroborno/fonts": ["./packages/fonts/dist/index.d.ts"],
      "@shoroborno/css": ["./packages/css/dist/index.d.ts"]
    }
  }
}
