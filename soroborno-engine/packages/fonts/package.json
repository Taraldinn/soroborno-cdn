{
  "name": "@soroborno/fonts",
  "version": "0.1.0",
  "description": "Generated font metadata, typed font definitions, and font catalog for the Soroborno ecosystem",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./data": "./data/fonts.json"
  },
  "dependencies": {
    "@soroborno/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": ["bangla", "fonts", "typography", "bengali", "soroborno"],
  "author": "Taraldinn",
  "license": "MIT"
}
