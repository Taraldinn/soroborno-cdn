{
  "name": "@shoroborno/vite",
  "version": "0.1.0",
  "description": "Vite plugin for Soroborno fonts with automated font injection and preloading",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@shoroborno/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": ["bangla", "fonts", "vite", "vite-plugin", "soroborno"],
  "author": "Taraldinn",
  "license": "MIT"
}
