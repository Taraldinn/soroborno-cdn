{
  "name": "soroborno-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Processing engine and package distribution system for the Soroborno Bangla font ecosystem",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "engine:process": "tsx engine/pipeline/cli.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish:packages": "pnpm -r publish --access public --no-git-checks",
    "clean": "rm -rf node_modules packages/*/dist packages/*/node_modules generated"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "opentype.js": "1.3.4",
    "wawoff2": "^2.0.1"
  }
}
